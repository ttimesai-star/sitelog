{
  "name": "delivery-score",
  "version": "0.1.0",
  "description": "Neutral pre-payment check of x402 sellers: probe the 402 challenge, buy as a mystery shopper, score delivery. Every probe and purchase is a signed AgentLog entry.",
  "type": "module",
  "license": "MIT",
  "author": "Artur Baranovsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttimesai-star/delivery-score.git"
  },
  "scripts": {
    "collect": "node src/collect.mjs",
    "probe": "node src/probe.mjs",
    "buy": "node src/buyer.mjs",
    "score": "node src/score.mjs",
    "verify": "node src/verify.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "agentlog": "github:ttimesai-star/agentlog",
    "viem": "^2.57.4"
  },
  "engines": {
    "node": ">=22.18"
  }
