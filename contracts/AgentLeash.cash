pragma cashscript ^0.14.0;

// AgentLeash: an AI agent may spend BCH from this covenant, but only
//   - up to `limit` satoshis of total outflow (payments + miner fees) per `period` blocks
//     (fixed window, clock in an NFT),
//   - only to one of three allow-listed locking bytecodes,
//   - with a miner fee of at most `maxFee` per payment,
//   - with an OP_RETURN receipt "LSH1" <32-byte request hash>.
// The owner can always take everything back by co-spending a P2PKH input of `ownerLock`.
//
// State lives in a single mutable NFT of category `stateCategory`:
//   commitment = elapsed (8 bytes LE) | spent (8 bytes LE)
// `elapsed` only advances by an amount proven with OP_CHECKSEQUENCEVERIFY (this.age),
// so the agent can never make the clock run faster than real block time.
//
// stateCategory must be given in VM (introspection) byte order, i.e. the reverse of the
// hex category shown by wallets / the CashScript SDK.
contract AgentLeash(
    bytes32 stateCategory,
    bytes20 agentPkh,
    bytes ownerLock,
    bytes allowA,
    bytes allowB,
    bytes allowC,
    int limit,
    int period,
    int maxFee,
) {
    // Agent payment. Transaction shape is fixed:
    //   in[0]  : this contract, carrying the mutable state NFT
    //   out[0] : this contract, state NFT with updated commitment, change
    //   out[1] : payment to an allow-listed recipient
    //   out[2] : OP_RETURN "LSH1" <requestHash32>
    function pay(pubkey agentPk, sig agentSig, int elapsedAdd) {
        // 1. Only the agent can spend (prevents griefing the allowance).
        require(hash160(agentPk) == agentPkh, "not the agent key");
        require(checkSig(agentSig, agentPk), "bad agent signature");

        // 2. Exactly one input, which is this contract.
        require(tx.inputs.length == 1, "pay: exactly one input");
        require(this.activeInputIndex == 0, "pay: contract must be input 0");

        // 3. Input carries exactly the mutable state NFT and no fungible tokens.
        bytes stateToken = stateCategory + 0x01;
        require(tx.inputs[0].tokenCategory == stateToken, "pay: input lacks state NFT");
        require(tx.inputs[0].tokenAmount == 0, "pay: input carries fungible tokens");

        // 4. Exactly three outputs.
        require(tx.outputs.length == 3, "pay: exactly three outputs");

        // 5. Output 0 returns the state NFT and change to this very contract.
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "pay: change must return to contract");
        require(tx.outputs[0].tokenCategory == stateToken, "pay: state NFT must return");
        require(tx.outputs[0].tokenAmount == 0, "pay: no fungible tokens on state output");
        require(tx.outputs[0].value >= 1000, "pay: state output below 1000 sats, top up");

        // 6. Output 1 pays an allow-listed recipient, carries no tokens, not dust.
        bytes recipient = tx.outputs[1].lockingBytecode;
        require(recipient == allowA || recipient == allowB || recipient == allowC, "pay: recipient not allow-listed");
        require(tx.outputs[1].tokenCategory == 0x, "pay: payment output carries tokens");
        int amount = tx.outputs[1].value;
        require(amount >= 546, "pay: payment below dust");

        // 7. Output 2 is the receipt: OP_RETURN PUSH4 "LSH1" PUSH32 <hash>.
        bytes receipt = tx.outputs[2].lockingBytecode;
        require(receipt.length == 39, "pay: bad receipt length");
        require(receipt.split(7)[0] == 0x6a044c53483120, "pay: bad receipt prefix");
        require(tx.outputs[2].value == 0, "pay: receipt must carry 0 sats");
        require(tx.outputs[2].tokenCategory == 0x, "pay: receipt carries tokens");

        // 8. Outflow = everything that leaves the contract (payment + miner fee). It is what
        //    counts against the limit, so many tiny payments cannot burn the balance via fees.
        int outflow = tx.inputs[0].value - tx.outputs[0].value;
        require(outflow - amount <= maxFee, "pay: fee above maxFee");

        // 9. Clock. elapsedAdd must fit the 16-bit block-based relative locktime field;
        //    larger values would be masked by CSV (bits >= 16, type flag bit 22) and
        //    would let the agent fast-forward the window.
        require(elapsedAdd >= 0, "pay: negative elapsedAdd");
        require(elapsedAdd < 65536, "pay: elapsedAdd out of range");
        require(this.age >= elapsedAdd, "pay: elapsedAdd exceeds proven UTXO age");

        // 10. Read old state.
        bytes commitment = tx.inputs[0].nftCommitment;
        require(commitment.length == 16, "pay: bad state commitment");
        bytes elapsedBytes, bytes spentBytes = commitment.split(8);
        int elapsed = int(elapsedBytes);
        int spent = int(spentBytes);

        int newElapsed = elapsed + elapsedAdd;
        int newSpent = spent + outflow;
        if (newElapsed >= period) {
            // window rolled over: unused allowance of the old window is not carried over
            newElapsed = 0;
            newSpent = outflow;
        }
        require(newSpent <= limit, "pay: limit exceeded");

        // 11. Write new state.
        require(tx.outputs[0].nftCommitment == toPaddedBytes(newElapsed, 8) + toPaddedBytes(newSpent, 8), "pay: wrong new state");
    }

    // Owner path: valid whenever the transaction also spends an input locked by ownerLock
    // (a P2PKH of the owner), which the owner's wallet signs with SIGHASH_ALL.
    // Withdraw, top up, migrate to new rules, burn the NFT, absorb stray UTXOs.
    function owner(int ownerInputIndex) {
        require(tx.inputs[ownerInputIndex].lockingBytecode == ownerLock, "owner: no owner input");
    }
}
